# Bu dosyayi kopyalayip degerleri doldurun. Gercek degerleri ASLA commit etmeyin.
# Flutter bu dosyayi otomatik okumaz; degerlerin nereye yazilacagi asagida.

# Supabase -> lib/core/supabase_config.dart (supabase_config.example.dart'i kopyalayin)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Maps
#   Android -> android/local.properties    : MAPS_API_KEY=...
#   iOS     -> ios/Flutter/Secrets.xcconfig : MAPS_API_KEY = ...
MAPS_API_KEY=
